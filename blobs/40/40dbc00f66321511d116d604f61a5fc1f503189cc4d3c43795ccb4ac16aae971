            <div property="schema:text" class="page__body"><script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script><p><a href="/candidates/candidate-filing-log-printable-version" title="Candidate Filing Log - Printable Version">Click here to see the printable version of the list of candidates for this election.</a>.</p><p><select class="form-control col-sm-3" id="select-vbm-app"><option value="0">Please select one</option><option value="1">2026 General Election</option></select></p><script>
    $(document).ready(function () {
        $('#select-vbm-app').change(function () {
            var val = $(this).val(),
                urls = {
                    '1': 'GEN2026'
             
                };
            if (val > 0) {
                //window.location.href = '/voting/candidate-info/candidate-filing-log-with-statements/candidate-filing-log-with-statements-' + urls[val];
                // update 2016-01-06
                //window.location.href = '/voting/candidate-info/candidate-filing-log-with-statements/choose-office?elec=' + urls[val];
                showContests(urls[val]);
            }
        });
        $('#contest').change(function () {
            console.log("change function detected");
            //showCandidates();
        });
    });
</script><script>
    //first function called
    function showContests(election) {
        //shows loading message to user
        var dest = $('#TestText').text('Loading...');
        //Clears out any text left in there
        var get_started = $('#getStarted').text('');
        $.ajax({
            type: 'POST',
            url: '/bin/voting/candidate_filing_log.php',
            data: { election: election },
            dataType: 'html'
        }).done(function (html) {
            $("#TestText").html(html);
            //need to bind the contest to the change event
            $('#contest').bind('change', function () {
                showCandidates();
            });
        });
    }
    //second function called
    function showCandidates() {
        console.log("show candidates function run");
        //shows loading message to user
        //Clears out any text left in there    
        $.ajax({
            url: '/bin/voting/candidate_filing_log_submit.php',
            method: "GET",
            data: $("#form_contest").serialize(),
            dataType: 'html'
        }).done(function (html) {
            $("#candidates").html(html);
        });
    }
</script><div id="TestText">&nbsp;</div><div id="candidates">&nbsp;</div></div>
      
  



